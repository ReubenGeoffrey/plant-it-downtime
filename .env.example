# ============================================================================
# YOKOHAMA MES PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# Port for local Node.js full-stack server (default: 8080)
PORT=8080

# JWT secret key for signing session tokens
JWT_SECRET=your-jwt-secret-key-here

# Supabase PostgreSQL database connection
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Service Role Key for administrative operations
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
